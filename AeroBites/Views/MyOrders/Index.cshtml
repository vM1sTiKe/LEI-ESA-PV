@model IEnumerable<AeroBites.Models.Cart>;

@{
    ViewData["Title"] = "Meus pedidos";
    ViewData["CurrentPage"] = Enums.CurrentPage.MyOrders;
}

<div class="content-myorders">
    <nav class="app-tab">
        <a class="app-tab-action active-tab">Pedidos Atuais</a>
        <a asp-action="History" class="app-tab-action">Historico</a>
    </nav>

    <div class="orders">
        @foreach (var order in Model) {
            <div class="order" data-ready-to-accept=@(order.Status == Enums.OrderStatus.Waiting) data-expanded="false">
                <div class="info" onclick="expander_handler(this)">
                    <span><b class="order-state">@order.Status</b>@order.RestaurantName&nbsp;&nbsp;&nbsp;&nbsp;<b>Data</b>: @order.PlacedDate&nbsp;&nbsp;&nbsp;&nbsp;<b>Total</b>: @order.TotalPrice.ToString("N2")€</span>
                    @if (order.Status == Enums.OrderStatus.Waiting) {
                        <button class="app-button save clickable" onclick="submit_form(this)">Recolher</button>
                        <form asp-action="RecieveOrder" asp-route-orderId="@order.Id" style="display: none"><input type="submit" /></form>
                    }
                    <i class="arrow"></i>
                </div>
                <div class="details">
                    <div class="products">
                        <b>Produtos</b>
                        <ul>
                            @foreach (var item in order.Items ?? []) {
                                <li>@item.Name&nbsp;&nbsp;&nbsp;&nbsp;@item.Price.ToString("N2")€</li>
                            }
                        </ul>
                    </div>
                    <div>
                        <span><b>Morada de entrega: </b>@order.CartAddress?.FullAddress</span>
                    </div>
                </div>
            </div>
        }
        
    </div>
</div>

<script>
    function submit_form(element) {
        element.parentElement.querySelector("form > input").click()
    }

    function expander_handler(element) {
        const div = element.parentElement
        const is_expanded = div.getAttribute("data-expanded") == "true"
        div.setAttribute("data-expanded", !is_expanded)
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}