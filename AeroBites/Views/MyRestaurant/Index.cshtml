@model AeroBites.Models.Restaurant;

@{
    ViewData["Title"] = "Meu Restaurante";
    ViewData["CurrentPage"] = Enums.CurrentPage.MyRestaurant;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="content-myrestaurant myrestaurant-geral">
    <div class="actions">
        <nav class="app-tab">
            <a class="app-tab-action active-tab">Geral</a>
            <a asp-action="Items" class="app-tab-action">Produtos</a>
            <a asp-action="Orders" class="app-tab-action">Pedidos</a>
        </nav>

        <button class="app-button app-color-green save clickable" onclick='document.querySelector("div.myrestaurant-geral > form > input").click()'>Guardar</button>
        <div class="remove-restaurant">
            <form asp-action="Remove" asp-route-restaurant="@Model.Id" asp-route-id="@Model.Id" style="display: none">
                <input type="submit" />
            </form>
            <button class="app-button app-warning-button clickable" onclick="call_hidden_form(this)">Remover meu restaurante</button>
        </div>
    </div>
    
    <form asp-action="Edit" class="app-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="app-form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <input type="submit"/>
    </form>

    <div class="bank-account">
        <hr />
        <div class="header-bank-account">
            <h1>Minha Conta Bancária</h1>
            @if (Model.PaymentMethod is null) {
                <form asp-action="Add" asp-controller="MyRestaurantPayPal" style="display: none"><input type="submit" /></form>
                <button onclick="call_hidden_form(this)" class="app-button app-color-green save clickable">Adicionar</button>
            } else {
                <form asp-action="Remove" asp-controller="MyRestaurantPayPal" asp-route-id="@Model.PaymentMethod.Id" style="display: none"><input type="submit" /></form>
                <button onclick="call_hidden_form(this)" class="app-button app-warning-button clickable">Remover</button>
            }
        </div>
        <div class="account">
            @if(Model.PaymentMethod is not null) {
                <svg viewBox="0 0 384 512"><path d="M111.4 295.9c-3.5 19.2-17.4 108.7-21.5 134-.3 1.8-1 2.5-3 2.5H12.3c-7.6 0-13.1-6.6-12.1-13.9L58.8 46.6c1.5-9.6 10.1-16.9 20-16.9 152.3 0 165.1-3.7 204 11.4 60.1 23.3 65.6 79.5 44 140.3-21.5 62.6-72.5 89.5-140.1 90.3-43.4 .7-69.5-7-75.3 24.2zM357.1 152c-1.8-1.3-2.5-1.8-3 1.3-2 11.4-5.1 22.5-8.8 33.6-39.9 113.8-150.5 103.9-204.5 103.9-6.1 0-10.1 3.3-10.9 9.4-22.6 140.4-27.1 169.7-27.1 169.7-1 7.1 3.5 12.9 10.6 12.9h63.5c8.6 0 15.7-6.3 17.4-14.9 .7-5.4-1.1 6.1 14.4-91.3 4.6-22 14.3-19.7 29.3-19.7 71 0 126.4-28.8 142.9-112.3 6.5-34.8 4.6-71.4-23.8-92.6z" /></svg>
                @Model.PaymentMethod.Details
            } else {
                <span class="no-account">Sem conta</span>
            }
        </div>
    </div>
    <div class="restaurant-location">
        <hr />
        <h1>Minha Localização</h1>
        <div class="header-restaurant-location">
            <div class="display-address-grid-container">
                <div class="lbl-address">
                    <h4 style="margin: 0;">Morada</h4>
                </div>
                <div class="address-inputs">
                    
                        <!-- Campo da morada com autocomplete -->
                        <input class="text-input" type="text" name="adrs" id="addressInput" autocomplete="off" />
                        <div id="suggestions" class="autocomplete-suggestions"></div>

                        <!-- Campos escondidos para latitude, longitude e endereço completo -->
                        <input type="hidden" name="Latitude" id="Latitude" />
                        <input type="hidden" name="Longitude" id="Longitude" />
                        <input type="hidden" name="FullAddress" id="FullAddress" />

                        <button type="submit" class="app-button app-color-green save clickable">Atualizar a morada</button>
                    
                </div>
                <div class="lbl-list">
                    <h4 style="margin: 0;">Lista</h4>
                </div>
                <div class="list-addresses"></div>
            </div>
            <div class="display-map">
                <div id="map"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadAddresses();

        var marker = null;
        var map = L.map('map').setView([38.52165, -8.83977], 10);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

         function placeMarker(lat, lng, popupText = null){
             if(!marker) {
                 marker = L.marker([lat, lng]).addTo(map);
             }
             else {
                 marker.setLatLng([lat, lng]);
             }

             if(popupText) {
                 marker.bindPopup(popupText).openPopup();
             }
         }

        function getAddress(lat, lng) {
            var url = `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`;
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    const displayName = data.display_name || "Morada não encontrada";
                    document.querySelector('input[name="adrs"]').value = displayName;
                    document.getElementById("FullAddress").value = displayName;
                    document.getElementById("Latitude").value = lat;
                    document.getElementById("Longitude").value = lng;
                })
                .catch(error => console.error('Erro ao obter endereço:', error));
        }

        map.on('click', function (e) {

            const {lat, lng} = e.latlng;
            placeMarker(lat, lng);
            getAddress(lat, lng);
        });

        let timer;
        document.getElementById("addressInput").addEventListener("input", function () {
            clearTimeout(timer);
            const query = this.value.trim();
            if(query.length < 3) {
                document.getElementById("suggestions").innerHTML = "";
                return;
            }
            timer = setTimeout(() => autocompleteAddress(query), 500);
        });

            function autocompleteAddress(query) {
                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`;
                fetch(url)
                    .then(response => response.json())
                    .then(data => {
                        const suggestionsContainer = document.getElementById("suggestions");
                        suggestionsContainer.innerHTML = "";
                        if(data.length === 0) return;

                        data.forEach(location => {
                            const item = document.createElement("div");
                            item.classList.add("suggestion-item");
                            item.textContent = location.display_name;
                            item.addEventListener("click", function() {
                                document.getElementById("addressInput").value = location.display_name;
                                placeMarker(location.lat, location.lon);
                                suggestionsContainer.innerHTML = "";

                                document.getElementById("FullAddress").value = location.display_name;
                                document.getElementById("Latitude").value = location.lat;
                                document.getElementById("Longitude").value = location.lon;
                            });
                            suggestionsContainer.appendChild(item);
                        });
                    })
                    .catch(error => console.error("Erro no autocomplete:", error));
            }

        document.getElementById("btn-save-address").addEventListener("click", function () {
            var address = document.querySelector('input[name="adrs"]').value;
            var latLng = marker.getLatLng();

            if (!address || !latLng) {
                alert("Por favor, selecione uma morada válida.");
                return;
            }

            // Atualizar os hidden inputs para envio posterior (caso necessário)
            document.getElementById("Latitude").value = latLng.lat;
            document.getElementById("Longitude").value = latLng.lng;
            document.getElementById("FullAddress").value = address;

                fetch('/MyRestaurant/AddAddress', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                lat: latLng.lat,
                lng: latLng.lng,
                fullAddress: address
            })
        }).then(r => {
            if (r.ok) {
                alert("Morada guardada com sucesso!");
            }
        });
    });



        // Função para converter a morada em coordenadas
        function getCoordinates(address) {
            var url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`;

        fetch(url)
            .then(response => response.json())
            .then(data => {
                if(data.length > 0) {
                    var lat = parseFloat(data[0].lat);
                    var lng = parseFloat(data[0].lon);

                    //Mover o mapa e o marcador para a nova localização
                    map.setView([lat, lng], 25);
                    marker.setLatLng([lat, lng]);
                } else {
                    alert("Morada não encontrada!");
                }
            })
            .catch(error => console.error('Erro ao obter coordenadas:', error));
        }

        // Capturar mudanças no input e atualizar a posição no mapa
        document.querySelector('input[name="adrs"]').addEventListener("change", function ()  {
            var address = this.value;
            if (address.length > 3) { //Evita chamadas para inputs vazios
                getCoordinates(address);
            }
        })

        function loadAddresses() {
        fetch("/Address/GetAllAddresses")
            .then(response => response.json())
            .then(addresses => {
                const listContainer = document.querySelector(".list-addresses");
                listContainer.innerHTML = ""; // Limpa a lista antes de carregar

                let activeAddress = addresses.find(a => a.isActive);
                if(activeAddress) {
                    placeMarker(activeAddress.latitude, activeAddress.longitude);
                    map.setView([activeAddress.latitude, activeAddress.longitude], 25);
                    document.querySelector('input[name="adrs"]').value = activeAddress.fullAddress;
                }

                addresses.forEach(address => {
                    const addressElement = document.createElement("div");
                    addressElement.classList.add("address-item");
                    if(address.isActive) addressElement.style.backgroundColor = "#d4edda";
                    addressElement.innerHTML = `
                        <p>${address.fullAddress}</p>
                        <button class="btn-select" data-id="${address.id}">Selecionar</button>
                        <button class="btn-delete" data-id="${address.id}">X</button>
                    `;
                    listContainer.appendChild(addressElement);
                });

                // Adicionar eventos aos botões
                document.querySelectorAll(".btn-select").forEach(btn => {
                    btn.addEventListener("click", function () {
                        selectAddress(this.dataset.id);
                    });
                });

                document.querySelectorAll(".btn-delete").forEach(btn => {
                    btn.addEventListener("click", function () {
                        removeAddress(this.dataset.id);
                    });
                });
            })
            .catch(error => console.error("Erro ao carregar moradas:", error));
        }

        async function selectAddress(addressId) {
            try {
                const response = await fetch(`/Address/SelectAddress?id=${addressId}`, {
                    method: 'POST'
                });

                if (response.ok) {
                    alert("Morada selecionada com sucesso!");
                    loadAddresses(); // Atualiza a lista de moradas
                } else {
                    alert("Erro ao selecionar a morada.");
                }
            } catch (error) {
                console.error("Erro na requisição:", error);
            }
        }

        function removeAddress(id) {
            fetch(`/Address/RemoveAddress?id=${id}`, { method: "POST" })
                .then(response => {
                    if (!response.ok) throw new Error("Erro ao remover morada");
                    loadAddresses(); // Atualiza a lista
                })
                .catch(error => console.error(error));
        }

        function renderAddresses(addresses) {
            const list = document.querySelector('.list-addresses');
            list.innerHTML = '';

            addresses.forEach(address => {
                const item = document.createElement('div');
                item.classList.add('address-item');
                if (address.isActive) item.style.backgroundColor = "#d4edda"; // Cor diferente para a ativa

                item.innerHTML = `
                    <span>${address.fullAddress}</span>
                    <button class="btn-select" onclick="selectAddress(${address.id})">Selecionar</button>
                `;

                list.appendChild(item);
            });
        }

    });

        document.querySelector("form.app-form").addEventListener("submit", function (e) {
        const fullAddress = document.getElementById("FullAddress").value;
        const lat = document.getElementById("Latitude").value;
        const lng = document.getElementById("Longitude").value;

        if (!fullAddress || !lat || !lng) {
            e.preventDefault();
            alert("Por favor, selecione uma morada da lista para atualizar.");
        }
    });
</script>