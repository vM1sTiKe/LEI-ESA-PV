@model List<AeroBites.Models.Cart>;

@{
    ViewData["Title"] = "Meu Restaurante";
    ViewData["CurrentPage"] = Enums.CurrentPage.MyRestaurant;
}

<div class="content-myrestaurant myrestaurant-orders">
    <div class="actions">
        <nav class="app-tab">
            <a asp-action="" class="app-tab-action">Geral</a>
            <a asp-action="Items" class="app-tab-action">Produtos</a>
            <a class="app-tab-action active-tab">Pedidos</a>
        </nav>
        <nav class="app-tab">
            <a class="app-tab-action active-tab">Pedidos</a>
            <a asp-action="OrdersHistory" class="app-tab-action">Histórico</a>
        </nav>
    </div>
    
    <div class="orders">
        @foreach(var order in Model) {
            <div class="order">
                <div class="order-header">
                    <span class="order-id">N: @order.Id</span>
                    @* Este if é para mostrar o botão de "começar preparo do pedido" e se entrar no else mostra o botão de "enviar" *@
                    @if(order.Status == Enums.OrderStatus.Placed) {
                        <form asp-action="StartPreparing" asp-controller="Cart" asp-route-id="@order.Id" method="post" style="display: none">
                            <input type="submit" />
                        </form>
                        <a class="app-icon small-icon clickable" onclick="submit_form(this)">
                            <svg viewBox="0 0 576 512"><path d="M240 144A96 96 0 1 0 48 144a96 96 0 1 0 192 0zm44.4 32C269.9 240.1 212.5 288 144 288C64.5 288 0 223.5 0 144S64.5 0 144 0c68.5 0 125.9 47.9 140.4 112l71.8 0c8.8-9.8 21.6-16 35.8-16l104 0c26.5 0 48 21.5 48 48s-21.5 48-48 48l-104 0c-14.2 0-27-6.2-35.8-16l-71.8 0zM144 80a64 64 0 1 1 0 128 64 64 0 1 1 0-128zM400 240c13.3 0 24 10.7 24 24l0 8 96 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-240 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l96 0 0-8c0-13.3 10.7-24 24-24zM288 464l0-112 224 0 0 112c0 26.5-21.5 48-48 48l-128 0c-26.5 0-48-21.5-48-48zM48 320l80 0 16 0 32 0c26.5 0 48 21.5 48 48s-21.5 48-48 48l-16 0c0 17.7-14.3 32-32 32l-64 0c-17.7 0-32-14.3-32-32l0-80c0-8.8 7.2-16 16-16zm128 64c8.8 0 16-7.2 16-16s-7.2-16-16-16l-16 0 0 32 16 0zM24 464l176 0c13.3 0 24 10.7 24 24s-10.7 24-24 24L24 512c-13.3 0-24-10.7-24-24s10.7-24 24-24z" /></svg>
                        </a>
                    } else {
                        <form asp-action="MarkAsSent" asp-controller="Cart" asp-route-restaurant="" asp-route-id="@order.Id" method="post" style="display: none">
                            <input type="submit" />
                        </form>
                        <a class="app-icon small-icon clickable" onclick="submit_form(this)">
                            <svg viewBox="0 0 512 512"><path d="M498.1 5.6c10.1 7 15.4 19.1 13.5 31.2l-64 416c-1.5 9.7-7.4 18.2-16 23s-18.9 5.4-28 1.6L284 427.7l-68.5 74.1c-8.9 9.7-22.9 12.9-35.2 8.1S160 493.2 160 480l0-83.6c0-4 1.5-7.8 4.2-10.8L331.8 202.8c5.8-6.3 5.6-16-.4-22s-15.7-6.4-22-.7L106 360.8 17.7 316.6C7.1 311.3 .3 300.7 0 288.9s5.9-22.8 16.1-28.7l448-256c10.7-6.1 23.9-5.5 34 1.4z" /></svg>
                        </a>
                    }                    
                </div>
                <div class="items">
                    @foreach (var item in order.Items)
                    {
                        <span class="item">@item.Name</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script>
    function submit_form(element) {
        element.parentElement.querySelector("form > input").click()
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}