@model AeroBites.Models.Restaurant; 

@{
    ViewData["Title"] = "Restaurantes";
}


<div class="content-restaurant">
    <div class="restaurant-menu-container">
        <div class="header-content">
            <header>
                <img class="banner" src="~/images/dummy-banner.jpg" alt="banner restaurant">
                <h1 class="name-restaurant">@Model.Name</h1>
                <div class="info">
                    <span>Avaliação 0.0 (0)</span>
                    <span>Tempo de entrega 00 min</span>
                    <span>Taxa de entrega 00,00€</span>
                </div>
            </header>
        </div>
        <div class="main-content">
            <main>
                <div class="categories">
                    @foreach(var category in Model.Categories)
                    {
                        <span>@category.Name</span>
                    }
                </div>
                <div class="products">
                    @foreach (var category in Model.Categories)
                    {
                        @foreach(var item in category.Items)
                        {
                            <div class="product">
                                <img src="~/images/dummy-food-option.jpeg" alt="bebidas" /><br />
                                <span>@item.Name</span>
                                <span>@item.Price €</span>
                            </div>
                        }
                    }
                </div>
                <div class="checkout">
                    <div class="cart-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z" /></svg>
                        <div class ="checkout-items-container">
                            <h1 class="cart-title">Carrinho</h1>
                            <div class="items-inside-popup">
                                @{
                                    var total = 0.0;

                                    foreach (var category in Model.Categories)
                                    {
                                        foreach (var item in category.Items)
                                        {
                                            <span class="item-name-label">@item.Name</span>
                                            <span class="item-price-label">@item.Price €</span>
                                            <br />
                                            total += item.Price;
                                        }
                                    }
                                    
                                }
                            </div>
                            <span class="cart-total-label">Total:</span>
                            <span class="cart-total-price">@total €</span>
                        </div>
                    </div>
                </div>

            </main>
        </div>

    </div>
</div>



